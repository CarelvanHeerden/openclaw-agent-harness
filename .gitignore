node_modules/
# dist/ is committed so OpenClaw's `plugins install git:...` works.
# The gateway runs `npm install --omit=dev`, which strips typescript so
# a build step post-install is not possible. See docs/INSTALL.md.
# dist/ intentionally NOT ignored.
*.log
.DS_Store
.env
.env.*
!.env.example
coverage/
.nyc_output/
.vscode/
.idea/
.cursor/
*.swp
.pnpm-store/
# beta.110: never commit a credential vault or its key. The default location is
# the harness data dir, but an operator pointing credentials.dir at the repo (or
# running the CLI from here) must not be one `git add -A` away from publishing
# every stored PAT.
harness-vault/
vault.key
vault.db
