{
  "name": "openclaw-agent-harness",
  "version": "2.0.0-rc.13",
  "description": "Confirmed control-plane orchestration for bounded repository changes",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "openclaw": {
    "extensions": [
      "./dist/index.js"
    ],
    "runtimeExtensions": [
      "./dist/index.js"
    ],
    "compat": {
      "pluginApi": ">=2026.3.24-beta.2",
      "minGatewayVersion": "2026.6.1"
    },
    "build": {
      "openclawVersion": "2026.6.1"
    }
  },
  "bin": {
    "openclaw-agent-harness-downgrade-preflight": "./scripts/check-downgrade.mjs",
    "openclaw-agent-harness-verify-artifact": "./scripts/verify-installed-artifact.mjs"
  },
  "files": [
    "dist",
    "openclaw.plugin.json",
    "README.md",
    "LICENSE",
    "docs",
    "scripts/check-downgrade.mjs",
    "scripts/verify-installed-artifact.mjs"
  ],
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.json && mkdir -p dist/state && cp src/state/schema.sql dist/state/schema.sql",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && GIT_CONFIG_GLOBAL=$PWD/tests/fixtures/gitconfig GIT_CONFIG_SYSTEM=/dev/null node --test --test-timeout=300000 tests/*.mjs",
    "test:no-build": "node --test --test-timeout=300000 tests/*.mjs",
    "smoke": "npm run build && node --import ./scripts/register-smoke-loader.mjs scripts/smoke.mjs",
    "docs:config": "npm run build && node scripts/gen-config-reference.mjs",
    "lint": "eslint 'src/**/*.ts'",
    "check:downgrade": "node scripts/check-downgrade.mjs",
    "verify:installed-artifact": "node scripts/verify-installed-artifact.mjs",
    "prepublishOnly": "npm run schema:check && npm run typecheck && npm run build",
    "schema:sync": "node scripts/gen-config-schema.mjs",
    "schema:check": "node scripts/gen-config-schema.mjs --check"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.207",
    "opencode-ai": "1.18.23",
    "fast-uri": "3.1.8",
    "hono": "4.13.8",
    "qs": "6.16.0",
    "@anthropic-ai/sdk": "0.111.0",
    "@modelcontextprotocol/sdk": "1.29.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/node": "^22.5.0",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "keywords": [
    "openclaw",
    "openclaw-plugin",
    "agent-harness",
    "claude",
    "claude-agent-sdk",
    "multi-agent",
    "orchestration"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/CarelvanHeerden/openclaw-agent-harness.git"
  },
  "license": "MIT",
  "author": "Carel van Heerden",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./openclaw.plugin.json": "./openclaw.plugin.json"
  },
  "bundledDependencies": [
    "@anthropic-ai/sdk",
    "@modelcontextprotocol/sdk",
    "zod",
    "fast-uri",
    "hono",
    "qs"
  ]
}
